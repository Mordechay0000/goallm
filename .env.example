# Goallm – environment variables (copy to .env and adjust; never commit the real .env)

# --- Secrets (auto-generated into .storage/ when unset; set explicitly when proxy and CRM run on different machines) ---
# SECRET_KEY=
# CRM_PROXY_SECRET=

# --- Addresses ---
CRM_BASE_URL=https://filter.example.org
# PROXY_PUBLIC_HOST=proxy.example.org      # shown to users on the "Connections" page
# PROXY_PUBLIC_PORT=8080
# FILTER_BIND_BASE_URL=off                  # disable the IP-binding page when everyone uses personal credentials
# CORS_ALLOW_ORIGINS=https://filter.example.org

# --- Who may set X-Forwarded-For (your mitmproxy host + the CRM reverse proxy). Everyone else is ignored. ---
# ("none" = nobody; run_cluster.sh uses it for proxy workers behind a TCP load balancer)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Proxy authentication ---
PROXY_REQUIRE_AUTH=1                        # 0 = no password at all (identity by IP only; dev / closed network)
# PROXY_AUTH=family:long-random-password   # legacy shared credential (identity by IP binding)

# --- Admin bootstrap ---
GOALLM_FIRST_USER_ADMIN=0                   # then: python -m crm.manage set-admin 05XXXXXXXX

# --- Image analysis ---
IMAGE_ANALYZER=openai                       # simulated (dev only!) | llama_cpp | openai
VLM_API_BASE=http://127.0.0.1:8001/v1
VLM_MODEL=Qwen/Qwen3.5-9B
# VLM_API_KEY=
VLM_YES_THRESHOLD=0.2                       # block when P(Yes) >= this (asymmetric: a miss is worse than a false block)
VLM_MAX_SIDE=1280                           # raise if small background figures are missed
VLM_MAX_ANIMATION_FRAMES=4
IMAGE_MAX_WORKERS=16                        # concurrent requests to the VLM server
VLM_REVIEW_LOW=0.05                         # P(Yes) between this and the threshold → human review queue (0 = off)
# VLM_DISABLE_THINKING=1                    # Qwen3.5 thinking mode off (faster, same answer format)
# MAX_EMBEDDED_IMAGES_PER_PAGE=300          # base64 images per body (HTML/JSON/JS/WebSocket); beyond → grey placeholder

# --- Per-video review (python -m core.filters.video.review_worker; needs ffmpeg) ---
VIDEO_FPS=1                                 # frames per second sampled (2 for fast-moving videos)
VIDEO_FORCE_ANALYZE_SEC=15                  # analyze a frame at least this often even when nothing changed
VIDEO_MAX_DURATION_SEC=7200                 # longer videos are not reviewed automatically
# VIDEO_FRAME_MAX_SIDE=1280                 # frame resolution sent to the model
# Change detection (a frame goes to the model only if something changed since the last ANALYZED frame):
# VIDEO_CHANGE_WIDTH=320                    # frame is reduced to this width
# VIDEO_CHANGE_TILE_PX=16                   # ...split into tiles of this size; ONE changed tile is enough
# VIDEO_CHANGE_PIXEL_DELTA=28               # per-pixel difference (0-255) that counts as changed
# VIDEO_CHANGE_TILE_FRACTION=0.03           # share of changed pixels that marks a tile as changed
# VIDEO_CHANGE_TILE_MEAN=10                 # ...or this mean difference in the tile (slow / low-contrast change)

# YouTube (worker downloads with yt-dlp; cloud IPs are often refused – see docs/deploy/YOUTUBE.he.md)
# YTDLP_PROXY=http://user:pass@residential-proxy:port
# YTDLP_COOKIES_FILE=/var/lib/goallm/youtube-cookies.txt
# VIDEO_YTDLP_MAX_HEIGHT=720

# --- Description check: the model reads title / description / channel / tags BEFORE any frame is downloaded ---
# (it can only block – a clean description still goes to the frame check; sound itself is not filtered)
# VIDEO_DESCRIPTION_CHECK=auto             # auto = on when IMAGE_ANALYZER=openai | 1 | 0
# DESCRIPTION_YES_THRESHOLD=0.2

# --- Text filter: hidden score, no language model (core/filters/text/scoring.py; words in word_lists/*) ---
# TEXT_WINDOW_WORDS=250                    # local window
# TEXT_WINDOW_BLOCK_SCORE=12               # a window scoring this blocks the page
# TEXT_PAGE_BLOCK_SCORE=30                 # ...or the whole page scoring this
# TEXT_HIDE_SCORE=10                       # a block (comment / card / list) scoring this is hidden by itself
# TEXT_HARD_WEIGHT=5                       # default weight of a hard word (blocked.txt)
# TEXT_CONTEXT_FACTOR=0.3                  # suspicious words on a Torah page; TEXT_MEDICAL_FACTOR=0.6 on a medical page

# --- Apps with certificate pinning: pass through after repeated failures, ONLY where the site is allowed (unfiltered!) ---
# AUTO_PASSTHROUGH_PINNED_APPS=1
# AUTO_PASSTHROUGH_MIN_FAILURES=2

# --- One-time login codes (without a provider, code login is refused) ---
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls                   # starttls | ssl | none
# SMTP_USER=noreply@example.org
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.org
# SMS_PROVIDER=webhook                     # twilio | webhook | none
# SMS_WEBHOOK_URL=https://sms-adapter.internal/send   # receives {"to": "+9725...", "text": "..."}
# SMS_WEBHOOK_TOKEN=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# OTP_DEV_LOG_CODES=1                      # DEVELOPMENT ONLY: write codes to the log instead of sending

# --- Privacy ---
TRAFFIC_LOG_RETENTION_DAYS=30
# SENSITIVE_PASSTHROUGH_DOMAINS=bankhapoalim.co.il,leumi.co.il,...   # TLS passthrough when allowed

# --- Storage ---
# GOALLM_STORAGE_DIR=/var/lib/goallm
